    {#
      D.5 · Contact form

      Wired to mailto: on submit. Static-site friendly, no third-party
      form service required, no JS framework. Builds a properly encoded
      mailto URL from the four fields and opens the user's email client.
      The user can then review and send from their own account.

      Placeholder address: hello@reshaped.example. Aaron to swap before
      deploy. The inline data-attribute is the single edit point.
    #}
    <form class="contact__form"
          id="contact"
          data-contact-email="hello@reshaped.example"
          onsubmit="return reshapedContactSubmit(this);">
      <span class="form-label">CONTACT FORM &middot; SHEET D &middot; 01</span>

      <div class="field">
        <label for="cf-name">Name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required>
      </div>

      <div class="field">
        <label for="cf-org">Company or organization</label>
        <input id="cf-org" name="org" type="text" autocomplete="organization">
      </div>

      <div class="field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required>
      </div>

      <div class="field">
        <label for="cf-hurts">Where it hurts</label>
        <textarea id="cf-hurts" name="hurts" rows="5" required placeholder="Too many screens. A UI that used to make sense but doesn't anymore. Users spending more time figuring out the software than doing their job."></textarea>
      </div>

      <button type="submit" class="submit">send</button>
    </form>

    <script>
      // Builds a mailto: URL from the form fields and opens the user's
      // email client. Returns false so the form does not navigate.
      function reshapedContactSubmit(form) {
        var to = form.dataset.contactEmail || 'hello@reshaped.example';
        var name  = (form.elements['name']  || {}).value || '';
        var org   = (form.elements['org']   || {}).value || '';
        var email = (form.elements['email'] || {}).value || '';
        var hurts = (form.elements['hurts'] || {}).value || '';

        var subject = 'Where it hurts: ' + (org || name || 'inquiry');
        var bodyLines = [
          'From: ' + name + (email ? ' <' + email + '>' : ''),
          org ? 'Org: ' + org : '',
          '',
          hurts,
          '',
          'Sent from the reshaped contact form.'
        ].filter(Boolean);

        var url = 'mailto:' + encodeURIComponent(to) +
                  '?subject=' + encodeURIComponent(subject) +
                  '&body='    + encodeURIComponent(bodyLines.join('\n'));

        window.location.href = url;
        return false;
      }
    </script>
  </div>

  {# D.6 · Response promise #}
  <aside class="contact__promise">
    We read every message that comes through here. We reply within two business days, usually less. If we are not the right fit, we say so, and we point you to a shop we think could help.
  </aside>

