<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>{{ title | escape }}</title><meta name="description" content="{{ description | escape }}"><link rel="canonical" href="{{ site.url }}{{ page.url | url }}"><link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Space+Mono:wght@400&display=swap" rel="stylesheet"><link rel="stylesheet" href="{{ '/css/styles.css' | url }}"><link rel="stylesheet" href="{{ '/css/design-plans.css' | url }}"><script src="{{ '/js/design-plans.js' | url }}" defer></script></head><body class="page--plan client-plan"><div class="sheet"><header class="deliverable-header"><a class="brand" href="{{ '/' | url }}">reshaped</a><span>DESIGN PLAN · {{ plan.name }}</span><a href="{{ '/#design-plans' | url }}">All plans ↗</a></header><main>{% block content %}{% endblock %}</main><footer class="deliverable-footer"><span>{{ plan.name }} · Design Plan · v{{ plan.document.version }}</span><span>Prepared by {{ plan.document.preparedBy }}</span></footer></div></body></html>
